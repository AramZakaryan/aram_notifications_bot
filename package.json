{
  "name": "aram_notifications_bot",
  "version": "0.1.0",
  "private": true,
  "description": "Log incoming Telegram text messages",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "dev:inspect": "node --inspect --watch --env-file-if-exists=.env src/index.ts",
    "dev:inspect:brk": "node --inspect-brk --watch --env-file-if-exists=.env src/index.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.23"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
